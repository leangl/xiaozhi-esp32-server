# Dockerfile-server-base
# Base image containing system dependencies and Python packages
# Required input: reviewed docker.io/library/python image including @sha256 digest.
ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ARG PYTHON_IMAGE
ENV HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" http_proxy="" https_proxy="" all_proxy=""

# Verify all exact Debian archives before the isolated offline installation.
COPY tools/service-dependency-lock.py /opt/service-dependency-lock.py
COPY tools/dependency-locks/voice-deb-arm64.lock /opt/voice-deb.lock
RUN python /opt/service-dependency-lock.py fetch /opt/voice-deb.lock /opt/locked-deb --base "${PYTHON_IMAGE}"
RUN --network=none python /opt/service-dependency-lock.py install-deb /opt/voice-deb.lock /opt/locked-deb --base "${PYTHON_IMAGE}" && \
    sed -i '/zh_CN.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /opt/locked-deb

# Dependency resolution uses only official PyPI with normal TLS verification.
# --isolated below ignores inherited pip configuration and pip index variables.

# Set locale variables for correct character encoding
ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    PYTHONIOENCODING=utf-8

WORKDIR /opt/xiaozhi-esp32-server

# Copy the direct declaration and reviewed transitive artifact/hash lock.
COPY main/xiaozhi-server/requirements.txt main/xiaozhi-server/requirements.lock ./

# Install Python dependencies
# No unbounded bootstrap upgrade. The selected Python base supplies pip.
# Refuse sdists so build isolation cannot fetch additional unlocked build tools.
RUN env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
    PIP_CONFIG_FILE=/dev/null python -m pip --isolated install \
    --index-url https://pypi.org/simple --no-cache-dir --only-binary=:all: \
    --require-hashes -r requirements.lock \
    --default-timeout=120 --retries 5 --report /opt/python-install-report.json && \
    python -m pip freeze --all > /opt/python-installed.txt
