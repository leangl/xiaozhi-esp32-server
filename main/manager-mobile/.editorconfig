root = true

[*] # Applies to all files
charset = utf-8 # Set the character encoding to utf-8
indent_style = space # Indentation style (tab | space)
indent_size = 2 # Indentation width
end_of_line = lf # Line-ending format (lf | cr | crlf)
trim_trailing_whitespace = true # Remove trailing whitespace
insert_final_newline = true # Always insert a final newline

[*.md] # Apply the following rules only to Markdown files
max_line_length = off # Disable the maximum line-length limit
trim_trailing_whitespace = false # Disable trailing-space trimming
