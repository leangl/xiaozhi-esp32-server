VUE_APP_API_BASE_URL=/xiaozhi
#1. To use the mobile layout, start manager-api and obtain its server URL (http://LAN-IP:8002/xiaozhi).
#2. In manager-mobile/.env, set VITE_SERVER_BASEURL to that URL. Run pnpm dev:h5 and put the resulting H5 page URL in VUE_APP_H5_URL below.
#3. Mobile browsers visiting the web page will then redirect to the mobile H5 page.
VUE_APP_H5_URL=
